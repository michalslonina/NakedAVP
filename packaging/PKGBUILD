# Maintainer: Michal Slonina <michal.slonina@gmail.com>
pkgname=nakedavp
pkgver=1.2.3
pkgrel=1
pkgdesc="Aliens versus Predator (NakedAVP) engine source port"
arch=('x86_64')
url="https://github.com/michalslonina/NakedAVP"
license=('custom:Rebellion-EULA')
depends=('sdl3' 'openal' 'libgl')
makedepends=('cmake' 'ninja')

# CI writes this tarball from the checkout being built (git archive), so the
# package matches the tested commit rather than whatever is on main.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
